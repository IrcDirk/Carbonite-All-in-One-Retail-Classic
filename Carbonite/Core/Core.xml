<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ ..\..\FrameXML\UI.xsd">
    <!-- Core load order matters: Bootstrap creates Carbonite global,
         Logger and EventBus hang off it, then SavedVariables and
         SlashCommands subscribe to lifecycle events. -->
    <Script file="Bootstrap.lua" />
    <Script file="Logger.lua" />
    <Script file="EventBus.lua" />
    <Script file="Module.lua" />
    <Script file="Plugin.lua" />
    <Script file="SavedVariables.lua" />
    <Script file="SlashCommands.lua" />
    <Script file="Versions.lua" />
    <Script file="DataPersistence.lua" />
</Ui>
