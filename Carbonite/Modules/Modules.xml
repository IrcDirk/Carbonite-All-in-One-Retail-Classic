<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ ..\..\FrameXML\UI.xsd">
    <!-- Options should load first so other modules can register
         their option pages during their own load. -->
    <Script file="Options\Options.lua" />

    <!-- Comm next: other modules may want to send addon messages
         on enable. -->
    <Script file="Comm\Comm.lua" />

    <!-- Map needs Pin / Layer / pin classes before the Map module
         itself can refer to them. Order matters here. -->
    <Script file="Map\Pin.lua" />
    <Script file="Map\Layer.lua" />
    <Script file="Map\Pathing.lua" />
    <Script file="Map\Coords.lua" />
    <Script file="Map\MapIDs.lua" />
    <Script file="Map\Hotspots.lua" />
    <Script file="Map\Targets.lua" />
    <Script file="Map\IconTypes.lua" />
    <Script file="Map\MinimapGlow.lua" />
    <Script file="Map\MiniMap.lua" />
    <Script file="Map\ViewState.lua" />
    <Script file="Map\ZoomController.lua" />
    <Script file="Map\ZoneIterator.lua" />
    <Script file="Map\Battleground.lua" />
    <Script file="Map\GroupTracking.lua" />
    <Script file="Map\ContinentLookup.lua" />
    <Script file="Map\FrameToWorld.lua" />
    <Script file="Map\MinimapButton.lua" />
    <Script file="Map\POICache.lua" />
    <Script file="Map\MapOpen.lua" />
    <Script file="Map\TravelGraph.lua" />
    <Script file="Map\Pins\QuestPin.lua" />
    <Script file="Map\Pins\GatherPin.lua" />
    <Script file="Map\Pins\PlayerPin.lua" />
    <Script file="Map\Pins\NotePin.lua" />
    <Script file="Map\Pins\TrainerPin.lua" />
    <Script file="Map\Map.lua" />

    <!-- HUD and Travel are simple module shells, order independent. -->
    <Script file="HUD\HUD.lua" />
    <Script file="Travel\Travel.lua" />

    <!-- Cross-cutting modules. -->
    <Script file="Whatsnew\Whatsnew.lua" />
    <Script file="CombatStats\CombatStats.lua" />
    <Script file="TitleScreen\TitleScreen.lua" />
    <Script file="UserEvents\UserEvents.lua" />
    <Script file="GroupMembers\GroupMembers.lua" />
    <Script file="ItemRegistry\ItemRegistry.lua" />
    <Script file="AuctionAssist\AuctionAssist.lua" />

    <!-- Gather data registry. -->
    <Script file="Gather\Gather.lua" />

    <!-- Integrations with sibling addons. -->
    <Script file="Integrations\TomTom.lua" />
    <Script file="Integrations\TomTomWaypoints.lua" />
</Ui>
